# App DB (async, runtime)
DATABASE_URL=postgresql+asyncpg://ponny_user:CHANGE_ME_PASSWORD@postgres:5432/ponny

# Alembic DB (sync, migrations)
ALEMBIC_DATABASE_URL=postgresql+psycopg://ponny_user:CHANGE_ME_PASSWORD@postgres:5432/ponny

# Tests (если pytest запускаешь на хосте — localhost; если внутри docker —  postgres)
TEST_DATABASE_URL=postgresql+asyncpg://ponny_user:CHANGE_ME_PASSWORD@localhost:5432/ponny_test

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ponny
POSTGRES_USER=ponny_user
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1